# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development

# Optional LLM config (the app runs 100% offline with rule-based fallback if left empty).
# Supported providers: gemini | openai | none
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Legacy / shortcut aliases also supported automatically by ml-py:
AI_API_KEY=
