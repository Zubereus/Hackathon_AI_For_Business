{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulateRequest",
  "type": "object",
  "properties": {
    "product": {
      "type": "object",
      "properties": {
        "current_price_vnd": { "type": "integer" },
        "unit_cost_vnd": { "type": "integer" },
        "baseline_qty_per_period": { "type": "integer" },
        "stock_available": { "type": ["integer", "null"] },
        "fixed_cost_vnd": { "type": ["integer", "null"] },
        "elasticity_samples": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "required": [
        "current_price_vnd",
        "unit_cost_vnd",
        "baseline_qty_per_period",
        "elasticity_samples"
      ]
    },
    "price_change_pct": { "type": "number" },
    "n_sims": { "type": "integer", "default": 10000 },
    "seed": { "type": "integer", "default": 42 },
    "schedule": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "days": { "type": "integer", "minimum": 1, "maximum": 90 },
          "start_change_pct": { "type": "number" },
          "daily_step_pct": { "type": "number" },
          "relative_to_prev": { "type": "boolean" },
          "compound_daily_step": { "type": "boolean" },
          "step_on_first_day": { "type": "boolean" }
        },
        "required": ["days"]
      }
    },
    "business_context": { "type": ["object", "null"] }
  },
  "required": ["product", "price_change_pct"]
}

